# Upgrade {{{

_upgrade_homebrew_packages() {
    _log_info "Upgrading homebrew packages"
    builtin cd "$HOME" || return
    HOMEBREW_BUNDLE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/Brewfile" brew bundle
    HOMEBREW_BUNDLE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/Brewfile" brew cu --yes
    builtin cd - || return
}

_upgrade_mise() {
    _log_info "Upgrading mise plugins and tools"
    mise plugins update --yes
    builtin cd "$HOME" || return
    mise install --yes
    mise upgrade --yes
    builtin cd - || return
}

_upgrade_zinit_plugins() {
    _log_info "Upgrading zinit plugins"
    zsh -c "source \"$XDG_DATA_HOME\"/zinit/zinit.git/zinit.zsh && zinit update --parallel"
}

_upgrade_spicetify() {
    _log_info "Upgrading spicetify"
    spicetify update
}

