#!/usr/bin/env bash
# yadm bootstrap: machine setup and upgrades. Runs automatically after `yadm clone`.
#
# Toggle what runs by commenting/uncommenting the calls at the bottom:
#   - Install section: first-time setup on a fresh machine
#   - Upgrade section: periodic tool upgrades (uncomment to run, re-comment after)

_log_info() { echo -e "$(tput setaf 2)$(tput rev)$(tput bold) \xE2\x9C\x93 $1 $(tput sgr0)"; }

system_type=$(uname -s)

# Install {{{

_change_shell_to_zsh() {
    which_zsh=$(which zsh)
    if ! [ "$SHELL" = "$which_zsh" ]; then
        _log_info "Changing shell to zsh"
        chsh -s "$which_zsh" "$USER"
    fi
}

_create_code_dir_if_missing() {
    _log_info "Creating code directory if missing"
    mkdir -p "$HOME/Code"
}

_install_mac_xcode_command_line_tools() {
    [ "$system_type" = "Darwin" ] || return
    _log_info "Installing mac xcode command line tools if missing"
    xcode-select --install || true
}

_install_homebrew() {
    if ! command -v brew &>/dev/null; then
        _log_info "Install homebrew"
        yes | /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
}

_install_homebrew_packages() {
    _log_info "Installing homebrew packages"
    builtin cd "$HOME" || return
    HOMEBREW_BUNDLE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/Brewfile" brew bundle
    builtin cd - || return
}

_install_mise_plugins() {
    _log_info "Installing mise plugins"
    mise plugins install php-brew https://github.com/ntzrbtr/asdf-php-brew.git
}

_install_mise_dependencies() {
    _log_info "Installing mise dependencies"
    builtin cd "$HOME" || return
    mise install --yes
    builtin cd - || return
}

_install_zinit() {
    zinit_home="$XDG_DATA_HOME"/zinit/zinit.git
    if ! [ -d "$zinit_home" ]; then
        _log_info "Installing zinit"
        mkdir -p "$(dirname "$zinit_home")"
        git clone https://github.com/zdharma-continuum/zinit.git "$zinit_home"
    fi
}

