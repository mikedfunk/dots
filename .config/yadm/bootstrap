#!/usr/bin/env bash
# yadm bootstrap: machine setup and upgrades. Runs automatically after `yadm clone`.
# Toggle what runs by commenting/uncommenting the calls at the bottom.

_log_info() { echo -e "$(tput setaf 2)$(tput rev)$(tput bold) â $1 $(tput sgr0)"; }

system_type=$(uname -s)
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

failed=()
# Run a step; remember its name if it fails so the summary at the end is honest.
_run() { "$@" || failed+=("$1"); }

# Prompt for sudo once up front (some casks need it) and keep it alive until the script exits.
_sudo_keepalive() {
    [ "$system_type" = "Darwin" ] || return 0
    sudo -v || return 1
    # macOS expires the sudo timestamp after 5 idle minutes; long brew steps
    # exceed that, so refresh it every 30s. Capture the loop PID explicitly —
    # $! inside an EXIT trap expands at trap-fire time and is fragile if later
    # steps background their own jobs. Echo if a refresh ever fails so a dying
    # keepalive is visible instead of silently expiring mid-run.
    while kill -0 "$$" 2>/dev/null; do
        sudo -n true 2>/dev/null || echo "sudo keepalive: timestamp refresh failed" >&2
        sleep 30
    done &
    _sudo_keepalive_pid=$!
    # shellcheck disable=SC2064 -- intentional: expand the PID now, not at EXIT.
    trap "kill ${_sudo_keepalive_pid} 2>/dev/null" EXIT
}

_change_shell_to_zsh() {
    which_zsh=$(which zsh)
    if ! [ "$SHELL" = "$which_zsh" ]; then
        _log_info "Changing shell to zsh"
        chsh -s "$which_zsh" "$USER"
    fi
}

_create_code_dir_if_missing() {
    _log_info "Creating code directory if missing"
    mkdir -p "$HOME/Code"
}

_install_mac_xcode_command_line_tools() {
    [ "$system_type" = "Darwin" ] || return 0
    xcode-select -p &>/dev/null && return 0
    _log_info "Installing mac xcode command line tools"
    xcode-select --install
}

_install_homebrew() {
    if ! command -v brew &>/dev/null; then
        _log_info "Install homebrew"
        yes | /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
    # Not on PATH yet right after a fresh install (Apple silicon prefix).
    command -v brew &>/dev/null || eval "$(/opt/homebrew/bin/brew shellenv)"
}

_install_upgrade_homebrew_packages() {
    _log_info "Installing/upgrading homebrew packages"
    (
        cd "$HOME" || exit 1
        export HOMEBREW_BUNDLE_FILE="$XDG_CONFIG_HOME/homebrew/Brewfile"
        rc=0
        brew bundle || rc=1
        brew cu --yes || rc=1
        exit $rc
    )
}

_install_upgrade_mise_plugins() {
    _log_info "Installing/upgrading mise plugins"
    mise plugins update --yes
    mise plugins ls | grep -qx php-brew ||
        mise plugins install php-brew https://github.com/ntzrbtr/asdf-php-brew.git
}

_install_and_upgrade_mise_dependencies() {
    _log_info "Installing/upgrading mise dependencies"
    (
        cd "$HOME" || exit 1
        mise install --yes && mise upgrade --yes
    )
}

_install_or_upgrade_zinit() {
    zinit_home="$XDG_DATA_HOME"/zinit/zinit.git
    if [ -d "$zinit_home" ]; then
        _log_info "Upgrading zinit"
        zsh -c "source "${zinit_home}"/zinit.zsh && zinit self-update"
    else
        _log_info "Installing zinit"
        mkdir -p "$(dirname "$zinit_home")"
        git clone https://github.com/zdharma-continuum/zinit.git "$zinit_home"
    fi
}

_upgrade_zinit_plugins() {
    _log_info "Upgrading zinit plugins"
    zsh -c "source "$XDG_DATA_HOME"/zinit/zinit.git/zinit.zsh && zinit update --parallel"
}

