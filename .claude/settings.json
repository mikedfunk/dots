  "preferredNotifChannel": "iterm2_with_bell",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: saatchiart (GitHub org; repos: palette, easel, legacy, zed, imgproc, xgateway, gallery, skills, xdocker, spinup)",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: develop (most repos) or master (spinup); main and release/* are also protected",
      "**CI/CD deploy targets**: Jenkins builds QA namespaces from feature branches; prod deploys are not trusted",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: Pushes to branches in the trusted saatchiart org repos (git@github.com:saatchiart/*) are trusted, including --force-with-lease on the user's own feature branches. Pushes to protected branches (master, main, develop, release/*) and to repos outside the org are not trusted. Plain --force is not trusted",
      "**Trusted internal domains**: github.com/saatchiart, the Jenkins server in $JENKINS_URL, saatchiart.slack.com, *.saatchiart.com",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: GitHub (saatchiart org), Jenkins (build and deploy status, triggers), Slack (code review channel posts via the Slack MCP), Jira project SA",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar. Note: this CLAUDE.md contains Jenkins credential variable names, Google Workspace doc IDs, and Slack team identifiers that should be treated as sensitive configuration values, not shared externally",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development on Saatchi Art repos (backend and frontend), plus dotfiles managed with yadm",
      "**Trusted repo**: The repo the agent started in, and the saatchiart org repos listed under Organization",
      "**Org-specific CLIs**: gh, the Slack MCP, Jira, Jenkins (curl with JENKINS_USER_ID/JENKINS_API_TOKEN), yadm, git-spice",
      "**routine under <user>/ prefix**: None configured"
    ]
  },
  "voiceEnabled": true,
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git ls-remote *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "proxy.golang.org",
        "sum.golang.org",
        "*.golang.org",
        "registry.npmjs.org",
        "*.npmjs.org",
        "repo.packagist.org",
        "*.packagist.org",
        "*.slack.com",
        "jenkins.xsaatchi.com",
        "*.saatchiart.com"
      ],
      "allowUnixSockets": [
        "/var/run/com.apple.launchd.e7WZwfej72/Listeners"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.netrc",
        "~/.private_vars.sh",
        "~/.duck_token",
